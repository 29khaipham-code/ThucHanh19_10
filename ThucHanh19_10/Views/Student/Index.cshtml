@model IEnumerable<ThucHanh19_10.Models.Student>

@{
    ViewData["Title"] = "Student List";
    Layout = "~/Views/Shared/MyLayout.cshtml";
}
@section Script{
    <script>
        var table = document.querySelector("table");
        table?.onclick = function onTableClick() {
            table.style = "background-color: yellow;"
        }
    </script>
}
<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Mã

            </th>
            <th>
                Họ Tên
            </th>
            <th>
                Ngày sinh
            </th>
            <th>
                Ngành
            </th>
            <th>
                Giới Tính
            </th>
            <th>
                Hệ DT
            </th>
            <th>
                Địa chỉ
            </th>
            <th>
                Email
            </th>
            <th></th>
        </tr 
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Id)
            </td>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                    @Html.DisplayFor(model => item.DateOfBorth)
            </td>
            @{
                    string str = "";
                    switch (item.Branch)
                    {
                        case Branch.IT:
                            str = "cntt";
                            break;
                        case Branch.BE:
                            str = "Kinh Te";
                            break;
                        case Branch.CE:
                            str = "Cong Trinh";
                            break;
                        case Branch.EE:
                            str = "Dien-Dien tu";
                            break;
                    }
                }
            <td>
                @str
            </td>
            <td>
                @(item.Gender == Gender.Male? "Nam" : "Nu")
            </td>
            <td>
                @(item.IsRegular ? "Chinh Quy" : "Phi Chinh Quy")
            </td>
            <td>
                @Html.DisplayFor(model => item.Address)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
