@model ThucHanh19_10.Models.Student

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>
<h4>Student</h4>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post" class="mt-3">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row mb-3">
                <label asp-for="Name" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9">
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Email" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9">
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Password" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9">
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <label asp-for="Branch" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9">
                    <select asp-for="Branch" class="form-select" asp-items="Html.GetEnumSelectList<Branch>()"></select>
                    <span asp-validation-for="Branch" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label asp-for="Gender" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9 d-flex align-items-center gap-3">
                    @foreach (var gender in ViewBag.AllGenders)
                    {
                        <div class="form-check">
                            <input type="radio" asp-for="Gender" value="@gender" id="Gender@(gender)" class="form-check-input" />
                            <label class="form-check-label" for="Gender@(gender)">@gender</label>
                        </div>
                    }
                </div>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="row mb-3">
                <label asp-for="IsRegular" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9 d-flex align-items-center">
                    <div class="form-check">
                        <input asp-for="IsRegular" class="form-check-input" />
                    </div>
                    <span asp-validation-for="IsRegular" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label asp-for="Address" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9">
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <label asp-for="DateOfBorth" class="col-sm-3 col-form-label"></label>
                <div class="col-sm-9">
                    <input asp-for="DateOfBorth" class="form-control" type="date" />
                    <span asp-validation-for="DateOfBorth" class="text-danger"></span>
                </div>
            </div>
            <div class="row mb-3">
                <div class="col-sm-9 offset-sm-3">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>